# autorun configuration — read by the claude-autorun plugin (v0.3).
# KEY=value, one per line, no expansion; an env var of the same name wins.
# NTFY_URL and NTFY_ANSWER_URL are env-only (secret topics) — never put them here.
# Set up 2026-10-05 for the validation track (decision log #3).

STATE_DIR=.autorun/state
LOG_DIR=.autorun/state/logs
PROMPT_FILE=.autorun/NEXT_TASK_PROMPT.md
LEDGER_FILE=.autorun/LEDGER.md
POLICY_FILE=.autorun/POLICY.md
NOTIFY_TITLE=vf-passport-pilot

# Model / effort by item kind (backlog.json sets each task's kind). Research, the
# pre-registration and all seller-facing copy (zh-CN) on Opus; plumbing on Sonnet. No haiku.
MODEL=opus
KIND_default=opus:high
KIND_design=opus:high
KIND_core=opus:high
KIND_research=opus:high
KIND_dossier=opus:high
KIND_impl=sonnet:high
KIND_comms=opus:high
KIND_run=sonnet:medium

CHECK_CMD=bash scripts/check.sh
CHECK_TIMEOUT=30m
REVIEW_LEVEL=high
GATE_ROUNDS=2

MAX_ITERS=20
PER_ITEM_TIMEOUT=4h
PER_ITEM_BUDGET_USD=25
MAX_TOTAL_USD=120

MAX_NUDGES=1
INFRA_RETRIES=1
INFRA_BACKOFF=2m
REPAIR_ATTEMPTS=1
MAX_LIMIT_WAIT=6h

# auto = a classifier reviews each action, plus the Bash sandbox from SETTINGS_FILE.
PERMISSION_MODE=auto
SETTINGS_FILE=.autorun/settings.loop.json

# Nothing is frozen in this phase (no reference answers yet).
# FROZEN_PATHS=
# The loop never edits its own rules, CI, the standing instructions or the pre-registrations
# (FD.1 gets PREREG-F through allow_paths in backlog.json).
PROTECTED_PATHS=.autorun/config.env,.autorun/POLICY.md,.autorun/guard_rules.py,.autorun/backlog.json,.autorun/settings.loop.json,.github/workflows/**,CLAUDE.md,.claude/**,scripts/check.sh,docs/planning/decisive-test.md,docs/planning/PREREG-F-fake-door.md
TEST_INTEGRITY=0
SECRET_SCAN=1

# Founder-review zones (CLAUDE.md): everything public-facing is judged by the independent
# read-only verifier with /claims-audit; the founder approves each piece on its card.
REVIEW_ZONES=site/**,docs/outreach/**
VERIFY_RUBRICS=.claude/commands/claims-audit.md
VERIFY_MODEL=opus
VERIFY_EFFORT=high
VERIFY_BUDGET_USD=6
VERIFY_TIMEOUT=20m
VERIFY_STRICT=0

# The supervisor (never a session) pushes each accepted item here; main is the founder's.
PUSH_REMOTE=origin
PUSH_BRANCH=autorun/loop

PAUSE_WAIT=12h
ANSWER_POLL=2m
CARD_URL=https://github.com/igridchyn/vf-passport-pilot/blob/autorun/loop/.autorun/attention/{id}.md

WORKTREE=0
